SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional Supabase overrides (publishable key is safe for server routing; never commit secret/service keys)
SUPABASE_URL=https://vmiaajhjcdqtojpyicux.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# V5 X intelligence
# Required for live X search. Store this only as a server-side Vercel environment variable.
X_BEARER_TOKEN=

# Optional depth controls. Recent Search supports the last 7 days.
# 1 page = up to 100 posts. Keep this low until you understand your X API usage/credits.
X_SEARCH_PAGES=1

# Enable only when your X developer access supports full-archive search.
X_FULL_ARCHIVE_ENABLED=0

# Optional protected calibration cron if one is enabled later
CRON_SECRET=

# V6 security corroboration
# RugCheck full token reports are queried keylessly by default.
# Optional only if you later receive a RugCheck API key.
RUGCHECK_API_KEY=

# Jupiter Tokens V2 adds optional verification + organic activity evidence.
# A free Jupiter API key is recommended; do not add a paid plan just for RCXT V6.
JUPITER_API_KEY=

# Keep disabled unless intentionally using Jupiter keyless access.
# Keyless access is more rate-limited than a free API key.
JUPITER_KEYLESS_ENABLED=0
